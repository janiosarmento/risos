# =============================================================================
# Risos - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# Only bootstrap settings live here. Everything else (AI endpoint, key and
# model, summary language, feed intervals, retention, UI behavior) is
# configured in the app under Settings and stored in the database.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Login password (choose a strong one). Once changed in Settings > Security,
# the stored password takes precedence over this value.
APP_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Path to the SQLite database file
DATABASE_PATH=./data/reader.db

# Maximum database size in MB; the retention job trims old posts above it
MAX_DB_SIZE_MB=1024

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Session TTL in hours (sliding window, renewed on each request)
SESSION_TTL_HOURS=168

# Login attempts per minute per IP
LOGIN_RATE_LIMIT=5

# -----------------------------------------------------------------------------
# SSH Fallback (feed fetch)
# -----------------------------------------------------------------------------

# When a feed fetch fails directly (timeout, connection error, HTTP error,
# etc.), retry once through a SOCKS5 tunnel over SSH to this host. Leave all
# four unset to disable (default) — direct-fetch errors are reported as-is.
SSH_FALLBACK_HOST=
SSH_FALLBACK_USER=
SSH_FALLBACK_PORT=22
SSH_FALLBACK_KEY_PATH=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Path to log file
LOG_FILE=./data/app.log

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Allowed CORS origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost

# Session cookie Secure flag — keep true in production (HTTPS).
# Set to false only for local development over plain HTTP.
COOKIE_SECURE=true

# Comma-separated Jano secret names the app may resolve as an AI API key
# (via /preferences jano_secret_name / background_jano_secret_name, and
# /admin/validate-secret). Keeps a compromised session from making the app
# decrypt unrelated host secrets. Set to the exact secrets you actually use.
JANO_AI_SECRET_ALLOWLIST=deepseek.api_key,gemini.api_key
